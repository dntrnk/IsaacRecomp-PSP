diff --git a/isaac_harness/src/main.rs b/isaac_harness/src/main.rs
new file mode 100644
index 00000000..99ea32c7
--- /dev/null
+++ b/isaac_harness/src/main.rs
@@ -0,0 +1,112 @@
+//! Headless Ruffle runner for differential tests against IsaacRecomp.
+//! isaac_harness <swf> <script> <frames>
+//! script lines: "<frame> down|up <flash keycode>", "<frame> click x y", "<frame> eval <cmd>", "<frame> quit"
+use ruffle_core::backend::locale::DeterministicLocaleBackend;
+use ruffle_core::events::{KeyDescriptor, KeyLocation, LogicalKey, MouseButton, NamedKey, PhysicalKey, PlayerEvent};
+use ruffle_core::limits::ExecutionLimit;
+use ruffle_core::tag_utils::movie_from_path;
+use ruffle_core::{FloatDuration, PlayerBuilder};
+use std::path::Path;
+use std::time::Duration;
+
+fn key(code: u32) -> KeyDescriptor {
+    let (logical, physical) = match code {
+        37 => (LogicalKey::Named(NamedKey::ArrowLeft), PhysicalKey::ArrowLeft),
+        38 => (LogicalKey::Named(NamedKey::ArrowUp), PhysicalKey::ArrowUp),
+        39 => (LogicalKey::Named(NamedKey::ArrowRight), PhysicalKey::ArrowRight),
+        40 => (LogicalKey::Named(NamedKey::ArrowDown), PhysicalKey::ArrowDown),
+        27 => (LogicalKey::Named(NamedKey::Escape), PhysicalKey::Escape),
+        13 => (LogicalKey::Named(NamedKey::Enter), PhysicalKey::Enter),
+        16 => (LogicalKey::Named(NamedKey::Shift), PhysicalKey::ShiftLeft),
+        32 => (LogicalKey::Character(' '), PhysicalKey::Space),
+        c if (65..=90).contains(&c) => {
+            let ch = char::from_u32(c + 32).unwrap();
+            let phys = [PhysicalKey::KeyA, PhysicalKey::KeyB, PhysicalKey::KeyC, PhysicalKey::KeyD, PhysicalKey::KeyE, PhysicalKey::KeyF, PhysicalKey::KeyG,
+                PhysicalKey::KeyH, PhysicalKey::KeyI, PhysicalKey::KeyJ, PhysicalKey::KeyK, PhysicalKey::KeyL, PhysicalKey::KeyM, PhysicalKey::KeyN,
+                PhysicalKey::KeyO, PhysicalKey::KeyP, PhysicalKey::KeyQ, PhysicalKey::KeyR, PhysicalKey::KeyS, PhysicalKey::KeyT, PhysicalKey::KeyU,
+                PhysicalKey::KeyV, PhysicalKey::KeyW, PhysicalKey::KeyX, PhysicalKey::KeyY, PhysicalKey::KeyZ][(c - 65) as usize];
+            (LogicalKey::Character(ch), phys)
+        }
+        _ => (LogicalKey::Unknown, PhysicalKey::Unknown),
+    };
+    KeyDescriptor { physical_key: physical, logical_key: logical, key_location: KeyLocation::Standard }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let swf = &args[1];
+    let script = std::fs::read_to_string(&args[2]).unwrap();
+    let frames: u32 = args[3].parse().unwrap();
+    let mut cmds: Vec<(u32, String, String)> = vec![];
+    for line in script.lines() {
+        let line = line.trim();
+        let mut it = line.splitn(3, ' ');
+        let (Some(t), Some(op)) = (it.next(), it.next()) else { continue };
+        let Ok(t) = t.parse::<u32>() else { continue };
+        cmds.push((t, op.to_string(), it.next().unwrap_or("").to_string()));
+    }
+    let movie = movie_from_path(Path::new(swf), None).unwrap();
+    let w = movie.width().to_pixels() as u32;
+    let h = movie.height().to_pixels() as u32;
+    let fps = movie.frame_rate().to_f64();
+    let frame_ms = 1000.0 / fps;
+    let player = PlayerBuilder::new()
+        .with_locale(DeterministicLocaleBackend::default())
+        .with_max_execution_duration(Duration::from_secs(300))
+        .with_viewport_dimensions(w, h, 1.0)
+        .with_movie(movie)
+        .with_autoplay(true)
+        .build();
+    let mut p = player.lock().unwrap();
+    p.preload(&mut ExecutionLimit::none());
+    let mut pos = 0;
+    let (mut aim_on, mut aim_key) = (false, 0u32);
+    for f in 0..frames {
+        ruffle_core::isaac_harness::set_virtual_ms((f as f64 * 1000.0 / fps).floor() as i64);
+        ruffle_core::isaac_harness::TICK.store(f as i64, std::sync::atomic::Ordering::Relaxed);
+        let mut quit = false;
+        while pos < cmds.len() && cmds[pos].0 <= f {
+            let (_, op, arg) = cmds[pos].clone();
+            pos += 1;
+            match op.as_str() {
+                "down" => {
+                    let c: u32 = arg.parse().unwrap();
+                    p.handle_event(PlayerEvent::KeyDown { key: key(c) });
+                    if c == 32 { p.handle_event(PlayerEvent::TextInput { codepoint: ' ' }); }   // (as the recomp's script: ascii only for Space)
+                }
+                "up" => { p.handle_event(PlayerEvent::KeyUp { key: key(arg.parse().unwrap()) }); }
+                "click" => {
+                    let v: Vec<f64> = arg.split_whitespace().map(|s| s.parse().unwrap()).collect();
+                    p.handle_event(PlayerEvent::MouseMove { x: v[0], y: v[1] });
+                    p.handle_event(PlayerEvent::MouseDown { x: v[0], y: v[1], button: MouseButton::Left, index: None });
+                    p.handle_event(PlayerEvent::MouseUp { x: v[0], y: v[1], button: MouseButton::Left });
+                }
+                "mmove" | "mdown" | "mup" => {
+                    let v: Vec<f64> = arg.split_whitespace().map(|s| s.parse().unwrap()).collect();
+                    let ev = match op.as_str() {
+                        "mmove" => PlayerEvent::MouseMove { x: v[0], y: v[1] },
+                        "mdown" => PlayerEvent::MouseDown { x: v[0], y: v[1], button: MouseButton::Left, index: None },
+                        _ => PlayerEvent::MouseUp { x: v[0], y: v[1], button: MouseButton::Left },
+                    };
+                    p.handle_event(ev);
+                }
+                "eval" if arg == "aim 1" => { aim_on = true; }
+                "eval" if arg == "aim 0" => { aim_on = false; if aim_key != 0 { p.handle_event(PlayerEvent::KeyUp { key: key(aim_key) }); aim_key = 0; } }
+                "eval" => { print!("{}", ruffle_core::isaac_harness::eval(&mut p, &arg)); }
+                "quit" => quit = true,
+                _ => {}
+            }
+        }
+        if quit { break; }
+        if aim_on {
+            let k: u32 = ruffle_core::isaac_harness::eval(&mut p, "aimkey").trim().parse().unwrap_or(0);
+            if k != aim_key {
+                if aim_key != 0 { p.handle_event(PlayerEvent::KeyUp { key: key(aim_key) }); }
+                if k != 0 { p.handle_event(PlayerEvent::KeyDown { key: key(k) }); }
+                aim_key = k;
+            }
+        }
+        p.run_frame();
+        p.update_timers(FloatDuration::from_millis(frame_ms));
+    }
+}
