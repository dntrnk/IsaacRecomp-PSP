diff --git a/core/src/isaac_harness.rs b/core/src/isaac_harness.rs
new file mode 100644
index 00000000..c613b412
--- /dev/null
+++ b/core/src/isaac_harness.rs
@@ -0,0 +1,192 @@
+//! Test harness hooks for comparing Ruffle with the IsaacRecomp native recomp (differential testing).
+//! Not part of upstream Ruffle.
+use crate::avm1::{Activation, ActivationIdentifier, ExecutionReason, Object, Value};
+use crate::context::UpdateContext;
+use crate::display_object::TDisplayObject;
+use crate::string::AvmString;
+use crate::Player;
+use std::sync::atomic::{AtomicI64, Ordering};
+
+pub static RNG_CALLS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+/// virtual getTimer() (ms); < 0 = real clock
+pub static VIRTUAL_MS: AtomicI64 = AtomicI64::new(-1);
+pub static TICK: AtomicI64 = AtomicI64::new(0);
+pub fn set_virtual_ms(ms: i64) {
+    VIRTUAL_MS.store(ms, Ordering::Relaxed);
+}
+
+fn get_path<'gc>(act: &mut Activation<'_, 'gc>, root: Object<'gc>, path: &str) -> Value<'gc> {
+    let mut cur = Value::Object(root);
+    for (i, part) in path.split('.').enumerate() {
+        if i == 0 && part == "_root" {
+            continue;
+        }
+        let o = match cur.as_object(act) {
+            Some(o) => o,
+            None => return Value::Undefined,
+        };
+        let name = AvmString::new_utf8(act.gc(), part);
+        cur = o.get(name, act).unwrap_or(Value::Undefined);
+        if i == 0 && matches!(cur, Value::Undefined) {
+            let g = act.global_object();
+            cur = g.get(name, act).unwrap_or(Value::Undefined);
+        }
+    }
+    cur
+}
+
+fn to_s<'gc>(act: &mut Activation<'_, 'gc>, v: Value<'gc>) -> String {
+    match v.coerce_to_string(act) {
+        Ok(s) => s.to_string(),
+        Err(_) => "?".to_string(),
+    }
+}
+
+fn parse_val<'gc>(act: &mut Activation<'_, 'gc>, s: &str) -> Value<'gc> {
+    if let Ok(n) = s.parse::<f64>() {
+        Value::Number(n)
+    } else if s == "true" {
+        Value::Bool(true)
+    } else if s == "false" {
+        Value::Bool(false)
+    } else {
+        Value::String(AvmString::new_utf8(act.gc(), s))
+    }
+}
+
+const BALL_FIELDS: &[&str] = &["e", "s", "xp", "yp", "xbew", "ybew", "hp", "fra", "_x", "_y", "_currentframe", "d._currentframe", "d.d._currentframe", "_rotation", "_xscale", "_alpha", "_visible", "d._x", "d._y", "d._rotation", "d._xscale", "d._visible", "dones"];
+
+fn run<'gc>(context: &mut UpdateContext<'gc>, cmd: &str) -> String {
+    let Some(root_clip) = context.stage.root_clip() else { return String::new() };
+    let mut act = Activation::from_nothing(context, ActivationIdentifier::root("[harness]"), root_clip);
+    let Some(root) = root_clip.object1() else { return String::new() };
+    let mut out = String::new();
+    if let Some(rest) = cmd.strip_prefix("set ") {
+        let mut it = rest.splitn(2, ' ');
+        let path = it.next().unwrap_or("");
+        let val = it.next().unwrap_or("");
+        let (obj, name) = match path.rfind('.') {
+            Some(p) => (get_path(&mut act, root, &path[..p]), &path[p + 1..]),
+            None => (Value::Object(root), path),
+        };
+        let v = parse_val(&mut act, val);
+        if let Some(o) = obj.as_object(&mut act) {
+            let n = AvmString::new_utf8(act.gc(), name);
+            let _ = o.set(n, v, &mut act);
+        }
+    } else if let Some(rest) = cmd.strip_prefix("copy ") {
+        // copy <dst path> <src path>
+        let parts: Vec<&str> = rest.split_whitespace().collect();
+        if parts.len() == 2 {
+            let v = get_path(&mut act, root, parts[1]);
+            let (obj, name) = match parts[0].rfind('.') {
+                Some(p) => (get_path(&mut act, root, &parts[0][..p]), &parts[0][p + 1..]),
+                None => (Value::Object(root), parts[0]),
+            };
+            if let Some(o) = obj.as_object(&mut act) {
+                let n = AvmString::new_utf8(act.gc(), name);
+                let _ = o.set(n, v, &mut act);
+            }
+        }
+    } else if let Some(rest) = cmd.strip_prefix("setat ") {
+        // setat <array path> <index path> <value>
+        let parts: Vec<&str> = rest.split_whitespace().collect();
+        if parts.len() == 3 {
+            let arr = get_path(&mut act, root, parts[0]);
+            let iv = get_path(&mut act, root, parts[1]);
+            let idx = to_s(&mut act, iv);
+            let v = parse_val(&mut act, parts[2]);
+            if let Some(o) = arr.as_object(&mut act) {
+                let n = AvmString::new_utf8(act.gc(), &idx);
+                let _ = o.set(n, v, &mut act);
+            }
+        }
+    } else if cmd == "aimkey" {
+        // the arrow key that shoots at the nearest living enemy (0: none); same rule as the recomp's autoAimKey
+        let px = get_path(&mut act, root, "_root.a.player.xp").coerce_to_f64(&mut act).unwrap_or(f64::NAN);
+        let py = get_path(&mut act, root, "_root.a.player.yp").coerce_to_f64(&mut act).unwrap_or(f64::NAN);
+        let mut best = f64::INFINITY; let (mut bx, mut by) = (0.0, 0.0);
+        if let Some(a) = get_path(&mut act, root, "_root.a.ball").as_object(&mut act) {
+            let len = a.get(AvmString::new_utf8(act.gc(), "length"), &mut act).ok().and_then(|v| v.coerce_to_f64(&mut act).ok()).unwrap_or(0.0) as usize;
+            for i in 0..len {
+                let b = a.get(AvmString::new_utf8(act.gc(), &i.to_string()), &mut act).unwrap_or(Value::Undefined);
+                let Some(bo) = b.as_object(&mut act) else { continue };
+                let sv = get_path(&mut act, bo, "s").coerce_to_f64(&mut act).unwrap_or(0.0);
+                let dones = get_path(&mut act, bo, "dones").as_bool(8);
+                let hp = get_path(&mut act, bo, "hp").coerce_to_f64(&mut act).unwrap_or(0.0);
+                if sv < 10.0 || dones || !(hp > 0.0) { continue; }
+                let x = get_path(&mut act, bo, "xp").coerce_to_f64(&mut act).unwrap_or(f64::NAN);
+                let y = get_path(&mut act, bo, "yp").coerce_to_f64(&mut act).unwrap_or(f64::NAN);
+                let d = (x - px) * (x - px) + (y - py) * (y - py);
+                if d < best { best = d; bx = x; by = y; }
+            }
+        }
+        let k = if !best.is_finite() { 0 } else {
+            let (dx, dy) = (bx - px, by - py);
+            if dx.abs() > dy.abs() { if dx > 0.0 { 39 } else { 37 } } else if dy > 0.0 { 40 } else { 38 }
+        };
+        out.push_str(&format!("{k}"));
+    } else if let Some(rest) = cmd.strip_prefix("call ") {
+        let parts: Vec<&str> = rest.split_whitespace().collect();
+        if parts.len() >= 2 {
+            let obj = get_path(&mut act, root, parts[0]);
+            let args: Vec<Value> = parts[2..].iter().map(|a| parse_val(&mut act, a)).collect();
+            if let Some(o) = obj.as_object(&mut act) {
+                let n = AvmString::new_utf8(act.gc(), parts[1]);
+                let r = o.call_method(n, &args, &mut act, ExecutionReason::Special);
+                let s = match r { Ok(v) => to_s(&mut act, v), Err(_) => "error".into() };
+                out.push_str(&format!("[call] {} = {}\n", rest, s));
+            } else {
+                out.push_str(&format!("[call] {} = undefined\n", rest));
+            }
+        }
+    } else if let Some(path) = cmd.strip_prefix("props ") {
+        let obj = get_path(&mut act, root, path);
+        if let Some(o) = obj.as_object(&mut act) {
+            let keys = o.get_keys(&mut act, false);
+            let mut kv: Vec<(String, String)> = vec![];
+            for k in keys {
+                let v = o.get(k, &mut act).unwrap_or(Value::Undefined);
+                let vs = match v { Value::Object(_) | Value::MovieClip(_) => "[obj]".to_string(), _ => to_s(&mut act, v) };
+                kv.push((k.to_string(), vs));
+            }
+            kv.sort();
+            for (k, v) in kv { out.push_str(&format!("[prop] {} {} = {}\n", path, k, v)); }
+        }
+    } else if cmd == "rng" {
+        out.push_str(&format!("[rng] {}\n", RNG_CALLS.load(Ordering::Relaxed)));
+    } else if cmd == "balls" || cmd.starts_with("balls ") {
+        let arr = get_path(&mut act, root, "_root.a.ball");
+        if let Some(a) = arr.as_object(&mut act) {
+            let len = a.get(AvmString::new_utf8(act.gc(), "length"), &mut act).ok().and_then(|v| v.coerce_to_f64(&mut act).ok()).unwrap_or(0.0) as usize;
+            for i in 0..len {
+                let b = a.get(AvmString::new_utf8(act.gc(), &i.to_string()), &mut act).unwrap_or(Value::Undefined);
+                let mut line = format!("[ball] {} {i}:", TICK.load(Ordering::Relaxed));
+                if let Some(bo) = b.as_object(&mut act) {
+                    for f in BALL_FIELDS {
+                        let v = get_path(&mut act, bo, f);
+                        line.push_str(&format!(" {}={}", f, to_s(&mut act, v)));
+                    }
+                }
+                out.push_str(&line);
+                out.push('\n');
+            }
+        }
+    } else {
+        let v = get_path(&mut act, root, cmd);
+        let s = to_s(&mut act, v);
+        out.push_str(&format!("[eval] {} = {}\n", cmd, s));
+    }
+    out
+}
+
+/// "path" (print), "set path value", "call path method args...", "balls" (the game's enemy list)
+pub fn eval(player: &mut Player, cmd: &str) -> String {
+    player.mutate_with_update_context(|context| {
+        let r = run(context, cmd);
+        if cmd.starts_with("call ") {
+            Player::run_actions(context); // (like the recomp's eval call)
+        }
+        r
+    })
+}
