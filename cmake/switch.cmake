# Nintendo Switch (homebrew): devkitA64 + libnx + portlibs (SDL2, mesa/EGL, libdrm_nouveau)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(NINTENDO_SWITCH TRUE)
if(NOT DEFINED ENV{DEVKITPRO})
  set(DEVKITPRO /opt/devkitpro)
else()
  set(DEVKITPRO $ENV{DEVKITPRO})
endif()
set(DEVKITA64 ${DEVKITPRO}/devkitA64)
set(LIBNX ${DEVKITPRO}/libnx)
set(PORTLIBS ${DEVKITPRO}/portlibs/switch)
set(CMAKE_C_COMPILER ${DEVKITA64}/bin/aarch64-none-elf-gcc)
set(CMAKE_CXX_COMPILER ${DEVKITA64}/bin/aarch64-none-elf-g++)
set(CMAKE_AR ${DEVKITA64}/bin/aarch64-none-elf-gcc-ar CACHE FILEPATH "")
set(CMAKE_RANLIB ${DEVKITA64}/bin/aarch64-none-elf-gcc-ranlib CACHE FILEPATH "")
set(SWITCH_ARCH "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE")
set(CMAKE_C_FLAGS_INIT "${SWITCH_ARCH} -ffunction-sections -D__SWITCH__ -isystem ${LIBNX}/include -isystem ${PORTLIBS}/include")
set(CMAKE_CXX_FLAGS_INIT "${SWITCH_ARCH} -ffunction-sections -D__SWITCH__ -isystem ${LIBNX}/include -isystem ${PORTLIBS}/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-specs=${LIBNX}/switch.specs ${SWITCH_ARCH} -L${PORTLIBS}/lib -L${LIBNX}/lib")
set(CMAKE_FIND_ROOT_PATH ${PORTLIBS} ${LIBNX} ${DEVKITA64})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_EXECUTABLE_SUFFIX ".elf")
